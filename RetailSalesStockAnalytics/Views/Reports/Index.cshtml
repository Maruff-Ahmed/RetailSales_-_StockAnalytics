
@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="container-fluid">

    <!-- HEADER -->

    <div class="mb-4">

        <h2 class="mb-1">
            📊 Reports Dashboard
        </h2>

        <p class="text-muted mb-0">
            Generate, filter and download management reports
            from all completed system modules.
        </p>

    </div>


    <!-- REPORT CARDS -->

    <div class="row">

        <!-- DAILY SALES -->

        <div class="col-md-6 col-xl-3 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="fs-2 mb-3">
                        📈
                    </div>

                    <h5>
                        Daily Sales Report
                    </h5>

                    <p class="text-muted">
                        View sales, revenue and transaction
                        information for a selected date range.
                    </p>

                    <a asp-controller="Reports"
                       asp-action="DailySales"
                       class="btn btn-primary">

                        Open Report

                    </a>

                </div>

            </div>

        </div>


        <!-- DEMANDING PRODUCTS -->

        <div class="col-md-6 col-xl-3 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="fs-2 mb-3">
                        📦
                    </div>

                    <h5>
                        Demanding Products
                    </h5>

                    <p class="text-muted">
                        Identify the products with the highest
                        demand during a selected period.
                    </p>

                    <a asp-controller="Reports"
                       asp-action="DailyDemandingProducts"
                       class="btn btn-primary">

                        Open Report

                    </a>

                </div>

            </div>

        </div>


        <!-- STOCK MOVEMENT -->

        <div class="col-md-6 col-xl-3 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="fs-2 mb-3">
                        🔄
                    </div>

                    <h5>
                        Stock Movement
                    </h5>

                    <p class="text-muted">
                        Analyze stock-in, stock-out and
                        adjustment transactions.
                    </p>

                    <a asp-controller="Reports"
                       asp-action="StockMovement"
                       class="btn btn-primary">

                        Open Report

                    </a>

                </div>

            </div>

        </div>


        <!-- AI COMPLAINT -->

        <div class="col-md-6 col-xl-3 mb-4">

            <div class="card shadow-sm h-100">

                <div class="card-body">

                    <div class="fs-2 mb-3">
                        🤖
                    </div>

                    <h5>
                        AI Complaint Routing
                    </h5>

                    <p class="text-muted">
                        Review AI complaint routing history,
                        similarity scores and routing status.
                    </p>

                    <a asp-controller="Reports"
                       asp-action="ComplaintRouting"
                       class="btn btn-primary">

                        Open Report

                    </a>

                </div>

            </div>

        </div>

    </div>


    <!-- REPORTING INFORMATION -->

    <div class="card shadow-sm mt-2">

        <div class="card-header">

            <strong>
                Reporting System
            </strong>

        </div>

        <div class="card-body">

            <div class="row">

                <div class="col-md-4">

                    <h6>
                        📅 Date Filtering
                    </h6>

                    <p class="text-muted">
                        Reports can be generated for a specific
                        start and end date.
                    </p>

                </div>


                <div class="col-md-4">

                    <h6>
                        📄 PDF Export
                    </h6>

                    <p class="text-muted">
                        Management reports can be downloaded
                        as PDF documents.
                    </p>

                </div>


                <div class="col-md-4">

                    <h6>
                        📊 Excel Export
                    </h6>

                    <p class="text-muted">
                        Report data can be downloaded as Excel
                        files for further analysis.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>
