@if (User.Identity?.IsAuthenticated == true)
{
    <li class="nav-item">
        <span class="nav-link">
            👤 @User.Identity.Name
        </span>
    </li>

    <li class="nav-item">
        <form asp-controller="Account"
              asp-action="Logout"
              method="post"
              class="d-inline">

            @Html.AntiForgeryToken()

            <button type="submit"
                    class="nav-link btn btn-link">
                Logout
            </button>

        </form>
    </li>
}
else
{
    <li class="nav-item">
        <a class="nav-link"
           asp-controller="Account"
           asp-action="Login">
            Login
        </a>
    </li>
}