@model RetailSalesStockAnalytics.Models.Category

@{
    ViewData["Title"] = "Edit Category";
}

<div class="container-fluid px-0 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Edit Category</h2>
            <p class="text-muted small mb-0">Update category details for Category ID #@Model.CategoryId.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                </svg>
                <span>Back to List</span>
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="row">
        <div class="col-lg-6 col-xl-5">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small" role="alert"></div>

                        <input type="hidden" asp-for="CategoryId" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-medium text-dark small">Category Name *</label>
                            <input asp-for="Name" class="form-control" placeholder="Enter category name" autofocus />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex align-items-center gap-2 pt-2">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-light text-secondary border px-3">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
