@model RetailSalesStockAnalytics.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";

    var maxDailyRevenue =
        Model.SalesTrend.Any()
            ? Model.SalesTrend.Max(x => x.Revenue)
            : 0;

    var maxCategoryRevenue =
        Model.SalesByCategory.Any()
            ? Model.SalesByCategory.Max(x => x.Revenue)
            : 0;

    var maxProductQuantity =
        Model.TopProducts.Any()
            ? Model.TopProducts.Max(x => x.QuantitySold)
            : 0;

    var totalStockMovement =
        Model.StockInQuantity + Model.StockOutQuantity;

    var routedPercentage =
        Model.TotalComplaints > 0
            ? (Model.RoutedComplaints * 100.0 /
               Model.TotalComplaints)
            : 0;

    var pendingPercentage =
        Model.TotalComplaints > 0
            ? (Model.PendingComplaints * 100.0 /
               Model.TotalComplaints)
            : 0;
}


<style>

    /* =====================================================
       DASHBOARD
    ====================================================== */

    .dashboard-wrapper {
        padding-bottom: 30px;
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .dashboard-header {
        margin-bottom: 25px;
    }

    .dashboard-header h1 {
        font-weight: 700;
        margin-bottom: 4px;
    }

    .dashboard-header p {
        color: #6c757d;
        margin-bottom: 0;
    }


    /* =====================================================
       KPI CARDS
    ====================================================== */

    .kpi-card {
        border: none;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        height: 100%;
        transition: transform 0.2s ease,
                    box-shadow 0.2s ease;
    }

    .kpi-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.09);
    }

    .kpi-content {
        padding: 22px;
    }

    .kpi-label {
        font-size: 14px;
        color: #6c757d;
        margin-bottom: 7px;
    }

    .kpi-value {
        font-size: 28px;
        font-weight: 700;
        margin-bottom: 0;
    }

    .kpi-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .icon-green {
        background: #e6f7f1;
    }

    .icon-blue {
        background: #e8f1ff;
    }

    .icon-orange {
        background: #fff3df;
    }

    .icon-red {
        background: #ffe9e9;
    }


    /* =====================================================
       DASHBOARD CARDS
    ====================================================== */

    .dashboard-card {
        border: none;
        border-radius: 14px;
        background: #ffffff;
        box-shadow: 0 3px 15px rgba(0,0,0,0.06);
        height: 100%;
    }

    .dashboard-card-header {
        padding: 20px 22px 8px;
        border-bottom: none;
    }

    .dashboard-card-header h5 {
        font-weight: 650;
        margin-bottom: 3px;
    }

    .dashboard-card-header small {
        color: #6c757d;
    }

    .dashboard-card-body {
        padding: 15px 22px 22px;
    }


    /* =====================================================
       SALES TREND
    ====================================================== */

    .trend-container {
        height: 220px;
        display: flex;
        align-items: flex-end;
        gap: 12px;
        padding: 15px 5px 0;
    }

    .trend-day {
        flex: 1;
        height: 100%;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        align-items: center;
    }

    .trend-bar-area {
        width: 100%;
        height: 175px;
        display: flex;
        align-items: flex-end;
        justify-content: center;
    }

    .trend-bar {
        width: 75%;
        max-width: 45px;
        min-height: 5px;
        border-radius: 7px 7px 2px 2px;
        background: #20b89c;
        transition: height 0.3s ease;
    }

    .trend-bar:hover {
        opacity: 0.8;
    }

    .trend-label {
        font-size: 12px;
        color: #6c757d;
        margin-top: 8px;
    }


    /* =====================================================
       CATEGORY BARS
    ====================================================== */

    .category-row {
        margin-bottom: 16px;
    }

    .category-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 5px;
        font-size: 13px;
    }

    .category-name {
        font-weight: 600;
    }

    .category-value {
        color: #6c757d;
    }

    .category-progress {
        height: 9px;
        background: #f0f2f5;
        border-radius: 20px;
        overflow: hidden;
    }

    .category-progress-bar {
        height: 100%;
        border-radius: 20px;
        background: #20b89c;
    }


    /* =====================================================
       TOP PRODUCTS
    ====================================================== */

    .product-row {
        margin-bottom: 17px;
    }

    .product-info {
        display: flex;
        justify-content: space-between;
        margin-bottom: 6px;
    }

    .product-name {
        font-size: 14px;
        font-weight: 600;
    }

    .product-quantity {
        font-size: 13px;
        color: #6c757d;
    }

    .product-progress {
        height: 11px;
        background: #f0f2f5;
        border-radius: 20px;
        overflow: hidden;
    }

    .product-progress-bar {
        height: 100%;
        border-radius: 20px;
        background: #4b8bd8;
    }


    /* =====================================================
       STOCK MOVEMENT
    ====================================================== */

    .movement-item {
        margin-bottom: 20px;
    }

    .movement-title {
        display: flex;
        justify-content: space-between;
        margin-bottom: 7px;
    }

    .movement-label {
        font-weight: 600;
    }

    .movement-number {
        font-weight: 700;
    }

    .movement-progress {
        height: 12px;
        background: #f0f2f5;
        border-radius: 20px;
        overflow: hidden;
    }

    .movement-in {
        height: 100%;
        background: #20b89c;
        border-radius: 20px;
    }

    .movement-out {
        height: 100%;
        background: #ef6a5b;
        border-radius: 20px;
    }


    /* =====================================================
       TABLE
    ====================================================== */

    .dashboard-table {
        margin-bottom: 0;
    }

    .dashboard-table th {
        font-size: 12px;
        text-transform: uppercase;
        letter-spacing: 0.3px;
        color: #6c757d;
        border-bottom-width: 1px;
    }

    .dashboard-table td {
        vertical-align: middle;
        font-size: 14px;
    }


    /* =====================================================
       LOW STOCK
    ====================================================== */

    .stock-alert {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        border-bottom: 1px solid #f0f0f0;
    }

    .stock-alert:last-child {
        border-bottom: none;
    }

    .stock-alert-name {
        font-weight: 600;
        font-size: 14px;
    }

    .stock-alert-level {
        font-size: 12px;
        color: #6c757d;
    }

    .stock-badge {
        background: #ffe8e8;
        color: #dc3545;
        border-radius: 20px;
        padding: 5px 10px;
        font-size: 12px;
        font-weight: 600;
    }


    /* =====================================================
       COMPLAINT SUMMARY
    ====================================================== */

    .complaint-number {
        font-size: 30px;
        font-weight: 700;
    }

    .complaint-label {
        color: #6c757d;
        font-size: 13px;
    }

    .complaint-stat {
        padding: 12px;
        border-radius: 10px;
        background: #f8f9fa;
    }


    /* =====================================================
       EMPTY STATE
    ====================================================== */

    .empty-state {
        text-align: center;
        padding: 35px 10px;
        color: #6c757d;
    }

</style>



<div class="dashboard-wrapper">


    <!-- =====================================================
         HEADER
    ====================================================== -->

    <div class="dashboard-header">

        <div class="d-flex justify-content-between
                    align-items-center">

            <div>

                <h1>
                    Manager Dashboard
                </h1>

                <p>
                    Retail Sales & Stock Analytics System
                </p>

            </div>

            <div class="d-none d-md-block">

                <span class="badge bg-success px-3 py-2">
                    System Ready
                </span>

            </div>

        </div>

    </div>



    <!-- =====================================================
         KPI CARDS
    ====================================================== -->

    <div class="row g-3 mb-4">


        <!-- Today's Revenue -->

        <div class="col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="kpi-content">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="kpi-label">
                                Today's Net Revenue
                            </div>

                            <div class="kpi-value text-success">

                                ৳@Model.TodayNetRevenue.ToString("N2")

                            </div>

                        </div>

                        <div class="kpi-icon icon-green">
                            💰
                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- Today's Sales -->

        <div class="col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="kpi-content">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="kpi-label">
                                Today's Sales
                            </div>

                            <div class="kpi-value text-primary">

                                @Model.TodaySalesCount

                            </div>

                        </div>

                        <div class="kpi-icon icon-blue">
                            🧾
                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- Total Stock -->

        <div class="col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="kpi-content">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="kpi-label">
                                Current Stock
                            </div>

                            <div class="kpi-value text-info">

                                @Model.TotalStockQuantity

                            </div>

                        </div>

                        <div class="kpi-icon icon-blue">
                            📦
                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- Low Stock -->

        <div class="col-md-6 col-xl-3">

            <div class="kpi-card">

                <div class="kpi-content">

                    <div class="d-flex
                                justify-content-between
                                align-items-start">

                        <div>

                            <div class="kpi-label">
                                Low Stock Products
                            </div>

                            <div class="kpi-value text-danger">

                                @Model.LowStockCount

                            </div>

                        </div>

                        <div class="kpi-icon icon-red">
                            ⚠️
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         SALES TREND + CATEGORY
    ====================================================== -->

    <div class="row g-4 mb-4">


        <!-- SALES TREND -->

        <div class="col-lg-7">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>
                        Sales Trend
                    </h5>

                    <small>
                        Last 7 days
                    </small>

                </div>

                <div class="dashboard-card-body">

                    @if (Model.SalesTrend.Any())
                    {
                        <div class="trend-container">

                            @foreach (var day in Model.SalesTrend)
                            {
                                var height =
                                maxDailyRevenue > 0
                                ? (double)(day.Revenue /
                                maxDailyRevenue) * 100
                                : 5;

                                <div class="trend-day">

                                    <div class="trend-bar-area">

                                        <div class="trend-bar"
                                             style="height:@height.ToString("0.##")%;"
                                             title="৳@day.Revenue.ToString("N2")">
                                        </div>

                                    </div>

                                    <div class="trend-label">

                                        @day.Date.ToString("ddd")

                                    </div>

                                </div>
                            }

                        </div>
                    }
                    else
                    {
                        <div class="empty-state">
                            No sales data available.
                        </div>
                    }

                </div>

            </div>

        </div>



        <!-- SALES BY CATEGORY -->

        <div class="col-lg-5">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>
                        Sales by Category
                    </h5>

                    <small>
                        Last 7 days
                    </small>

                </div>

                <div class="dashboard-card-body">

                    @if (Model.SalesByCategory.Any())
                    {
                        @foreach (var category in Model.SalesByCategory)
                        {
                            var width =
                            maxCategoryRevenue > 0
                            ? (double)(category.Revenue /
                            maxCategoryRevenue) * 100
                            : 0;

                            <div class="category-row">

                                <div class="category-info">

                                    <span class="category-name">
                                        @category.CategoryName
                                    </span>

                                    <span class="category-value">
                                        ৳@category.Revenue.ToString("N0")
                                    </span>

                                </div>

                                <div class="category-progress">

                                    <div class="category-progress-bar"
                                         style="width:@width.ToString("0.##")%;">
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            No category sales data available.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         TOP PRODUCTS + STOCK MOVEMENT
    ====================================================== -->

    <div class="row g-4 mb-4">


        <!-- TOP PRODUCTS -->

        <div class="col-lg-7">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>
                        Top Products
                    </h5>

                    <small>
                        Based on quantity sold in the last 7 days
                    </small>

                </div>

                <div class="dashboard-card-body">

                    @if (Model.TopProducts.Any())
                    {
                        @foreach (var product in Model.TopProducts)
                        {
                            var width =
                            maxProductQuantity > 0
                            ? (double)product.QuantitySold /
                            maxProductQuantity * 100
                            : 0;

                            <div class="product-row">

                                <div class="product-info">

                                    <span class="product-name">
                                        @product.ProductName
                                    </span>

                                    <span class="product-quantity">
                                        @product.QuantitySold units
                                    </span>

                                </div>

                                <div class="product-progress">

                                    <div class="product-progress-bar"
                                         style="width:@width.ToString("0.##")%;">
                                    </div>

                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="empty-state">
                            No product sales data available.
                        </div>
                    }

                </div>

            </div>

        </div>



        <!-- STOCK MOVEMENT -->

        <div class="col-lg-5">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>
                        Stock Movement
                    </h5>

                    <small>
                        Last 7 days
                    </small>

                </div>

                <div class="dashboard-card-body">

                    @if (totalStockMovement > 0)
                    {

                        <div class="movement-item">

                            <div class="movement-title">

                                <span class="movement-label">
                                    Stock In
                                </span>

                                <span class="movement-number text-success">
                                    @Model.StockInQuantity
                                </span>

                            </div>

                            <div class="movement-progress">

                                <div class="movement-in"
                                     style="width:@((Model.StockInQuantity * 100.0 / totalStockMovement).ToString("0.##"))%;">
                                </div>

                            </div>

                        </div>


                        <div class="movement-item">

                            <div class="movement-title">

                                <span class="movement-label">
                                    Stock Out
                                </span>

                                <span class="movement-number text-danger">
                                    @Model.StockOutQuantity
                                </span>

                            </div>

                            <div class="movement-progress">

                                <div class="movement-out"
                                     style="width:@((Model.StockOutQuantity * 100.0 / totalStockMovement).ToString("0.##"))%;">
                                </div>

                            </div>

                        </div>

                    }
                    else
                    {
                        <div class="empty-state">
                            No stock movement recorded.
                        </div>
                    }

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         RECENT SALES + LOW STOCK
    ====================================================== -->

    <div class="row g-4 mb-4">


        <!-- RECENT SALES -->

        <div class="col-lg-7">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>
                        Recent Sales
                    </h5>

                    <small>
                        Latest transactions
                    </small>

                </div>

                <div class="dashboard-card-body p-0">

                    @if (Model.RecentSales.Any())
                    {

                        <div class="table-responsive">

                            <table class="table
                                              dashboard-table
                                              table-hover">

                                <thead>

                                    <tr>

                                        <th>
                                            Sale
                                        </th>

                                        <th>
                                            Customer
                                        </th>

                                        <th>
                                            Date
                                        </th>

                                        <th class="text-end">
                                            Amount
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var sale in Model.RecentSales)
                                    {

                                        <tr>

                                            <td>
                                                #@sale.SaleId
                                            </td>

                                            <td>
                                                @sale.CustomerName
                                            </td>

                                            <td>
                                                @sale.SaleDate.ToString("dd MMM yyyy")
                                            </td>

                                            <td class="text-end fw-semibold">

                                                ৳@sale.TotalAmount.ToString("N2")

                                            </td>

                                        </tr>

                                    }

                                </tbody>

                            </table>

                        </div>

                    }
                    else
                    {
                        <div class="empty-state">
                            No sales recorded yet.
                        </div>
                    }

                </div>

            </div>

        </div>



        <!-- LOW STOCK -->

        <div class="col-lg-5">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>
                        Low Stock Products
                    </h5>

                    <small>
                        Products at or below reorder level
                    </small>

                </div>

                <div class="dashboard-card-body">

                    @if (Model.LowStockProducts.Any())
                    {

                        @foreach (var product in Model.LowStockProducts)
                        {

                            <div class="stock-alert">

                                <div>

                                    <div class="stock-alert-name">
                                        @product.ProductName
                                    </div>

                                    <div class="stock-alert-level">
                                        Reorder level:
                                        @product.ReorderLevel
                                    </div>

                                </div>

                                <span class="stock-badge">

                                    @product.StockQuantity left

                                </span>

                            </div>

                        }

                    }
                    else
                    {

                        <div class="empty-state">

                            <div class="fs-3 mb-2">
                                ✓
                            </div>

                            No low-stock products.

                        </div>

                    }

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         AI COMPLAINT SUMMARY
    ====================================================== -->

    <div class="row g-4">


        <div class="col-12">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <h5>
                        AI Complaint Routing
                    </h5>

                    <small>
                        Complaint routing overview
                    </small>

                </div>

                <div class="dashboard-card-body">

                    <div class="row g-3">


                        <!-- Total -->

                        <div class="col-md-4">

                            <div class="complaint-stat">

                                <div class="complaint-number">

                                    @Model.TotalComplaints

                                </div>

                                <div class="complaint-label">
                                    Total Complaints
                                </div>

                            </div>

                        </div>


                        <!-- Routed -->

                        <div class="col-md-4">

                            <div class="complaint-stat">

                                <div class="complaint-number text-success">

                                    @Model.RoutedComplaints

                                </div>

                                <div class="complaint-label">

                                    Routed
                                    (@routedPercentage.ToString("0")%)

                                </div>

                            </div>

                        </div>


                        <!-- Pending -->

                        <div class="col-md-4">

                            <div class="complaint-stat">

                                <div class="complaint-number text-warning">

                                    @Model.PendingComplaints

                                </div>

                                <div class="complaint-label">

                                    Pending
                                    (@pendingPercentage.ToString("0")%)

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>