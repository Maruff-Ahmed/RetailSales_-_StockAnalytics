@model IEnumerable<RetailSalesStockAnalytics.Models.Product>

@{
    ViewData["Title"] = "Products";
}

<div class="container-fluid px-0 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Product Inventory</h2>
            <p class="text-muted small mb-0">Manage your product catalog, stock levels, and pricing.</p>
        </div>
        @if (User.IsInRole("Admin"))
        {
            <div>
                <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
                    </svg>
                    <span>Add Product</span>
                </a>
            </div>
        }
    </div>

    <!-- Data Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary border-bottom">
                        <tr>
                            <th scope="col" class="ps-4 py-3 fw-semibold">
                                @Html.DisplayNameFor(model => model.Name)
                            </th>
                            <th scope="col" class="py-3 fw-semibold">
                                @Html.DisplayNameFor(model => model.Category)
                            </th>
                            <th scope="col" class="py-3 fw-semibold text-end">
                                @Html.DisplayNameFor(model => model.PurchasePrice)
                            </th>
                            <th scope="col" class="py-3 fw-semibold text-end">
                                @Html.DisplayNameFor(model => model.SellingPrice)
                            </th>
                            <th scope="col" class="py-3 fw-semibold text-center">
                                @Html.DisplayNameFor(model => model.StockQuantity)
                            </th>
                            <th scope="col" class="py-3 fw-semibold text-center">
                                @Html.DisplayNameFor(model => model.ReorderLevel)
                            </th>
                            <th scope="col" class="pe-4 py-3 text-end fw-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <div class="py-3">
                                        <p class="mb-2 fw-semibold">No products found</p>
                                        <small>Get started by creating your first product record.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td class="ps-4 py-3">
                                        <span class="fw-semibold text-dark">
                                            @Html.DisplayFor(modelItem => item.Name)
                                        </span>
                                    </td>
                                    <td class="py-3">
                                        <span class="badge bg-light text-dark border px-2.5 py-1.5 fw-medium">
                                            @Html.DisplayFor(modelItem => item.Category.Name)
                                        </span>
                                    </td>
                                    <td class="py-3 text-end font-monospace text-secondary">
                                        ৳@item.PurchasePrice.ToString("N2")
                                    </td>
                                    <td class="py-3 text-end font-monospace fw-bold text-dark">
                                        ৳@item.SellingPrice.ToString("N2")
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge @(item.StockQuantity <= item.ReorderLevel ? "bg-danger-subtle text-danger border border-danger-subtle" : "bg-success-subtle text-success border border-success-subtle") px-2 py-1 rounded-pill">
                                            @Html.DisplayFor(modelItem => item.StockQuantity)
                                        </span>
                                    </td>
                                    <td class="py-3 text-center text-muted">
                                        @Html.DisplayFor(modelItem => item.ReorderLevel)
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Product Actions">
                                            <a asp-action="Details" asp-route-id="@item.ProductId" class="btn btn-outline-secondary" title="Details">
                                                Details
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Edit" asp-route-id="@item.ProductId" class="btn btn-outline-secondary" title="Edit">
                                                    Edit
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.ProductId" class="btn btn-outline-danger" title="Delete">
                                                    Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
