@model RetailSalesStockAnalytics.Models.Product

@{
    ViewData["Title"] = "Edit Product";
}

<div class="container-fluid px-0 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Edit Product</h2>
            <p class="text-muted small mb-0">Update item information, pricing details, and inventory stock levels.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1">
                <i class="bi bi-arrow-left"></i>
                <span>Back to List</span>
            </a>
        </div>
    </div>

    <!-- Form Card -->
    <div class="row">
        <div class="col-lg-8 col-xl-7">
            <div class="card border-0 shadow-sm rounded-3">
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 mb-3 small" role="alert"></div>

                        <!-- Hidden Primary Key -->
                        <input type="hidden" asp-for="ProductId" />

                        <!-- General Info Section -->
                        <h6 class="fw-semibold text-secondary text-uppercase small tracking-wide mb-3">General Information</h6>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-medium text-dark small"></label>
                            <input asp-for="Name" class="form-control" placeholder="Product name" />
                            <span asp-validation-for="Name" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="CategoryId" class="form-label fw-medium text-dark small"></label>
                            <select asp-for="CategoryId" class="form-select" asp-items="ViewBag.CategoryId"></select>
                            <span asp-validation-for="CategoryId" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <hr class="text-muted opacity-25 my-4" />

                        <!-- Pricing Section -->
                        <h6 class="fw-semibold text-secondary text-uppercase small tracking-wide mb-3">Pricing</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="PurchasePrice" class="form-label fw-medium text-dark small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">$</span>
                                    <input asp-for="PurchasePrice" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="PurchasePrice" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="SellingPrice" class="form-label fw-medium text-dark small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light text-muted">$</span>
                                    <input asp-for="SellingPrice" class="form-control" placeholder="0.00" />
                                </div>
                                <span asp-validation-for="SellingPrice" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <hr class="text-muted opacity-25 my-4" />

                        <!-- Stock Section -->
                        <h6 class="fw-semibold text-secondary text-uppercase small tracking-wide mb-3">Stock & Thresholds</h6>
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <label asp-for="StockQuantity" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="StockQuantity" class="form-control" placeholder="0" />
                                <span asp-validation-for="StockQuantity" class="text-danger small mt-1 d-block"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ReorderLevel" class="form-label fw-medium text-dark small"></label>
                                <input asp-for="ReorderLevel" class="form-control" placeholder="0" />
                                <span asp-validation-for="ReorderLevel" class="text-danger small mt-1 d-block"></span>
                            </div>
                        </div>

                        <!-- Form Actions -->
                        <div class="d-flex align-items-center gap-2 pt-2">
                            <button type="submit" class="btn btn-primary px-4 shadow-sm">
                                Save Changes
                            </button>
                            <a asp-action="Index" class="btn btn-light text-secondary border px-3">
                                Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}