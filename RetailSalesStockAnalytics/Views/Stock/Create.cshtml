@model RetailSalesStockAnalytics.ViewModels.StockRestockViewModel

@{
    ViewData["Title"] = "Restock Product";
}

<h1>Restock Product</h1>

<hr />

<div class="row">

    <div class="col-md-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <form asp-action="Create" method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- Product -->

                    <div class="mb-3">

                        <label asp-for="ProductId"
                               class="form-label">
                            Product
                        </label>

                        <select asp-for="ProductId"
                                asp-items="ViewBag.Products"
                                class="form-select">

                            <option value="">
                                -- Select Product --
                            </option>

                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Quantity -->

                    <div class="mb-3">

                        <label asp-for="Quantity"
                               class="form-label">
                            Quantity
                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               min="1"
                               class="form-control" />

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Unit Cost -->

                    <div class="mb-3">

                        <label asp-for="UnitCost"
                               class="form-label">
                            Unit Cost
                        </label>

                        <div class="input-group">

                            <span class="input-group-text">
                                ৳
                            </span>

                            <input asp-for="UnitCost"
                                   type="number"
                                   min="0.01"
                                   step="0.01"
                                   class="form-control" />

                        </div>

                        <span asp-validation-for="UnitCost"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Note -->

                    <div class="mb-3">

                        <label asp-for="Note"
                               class="form-label">
                            Note
                        </label>

                        <textarea asp-for="Note"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Example: New supplier shipment">
                        </textarea>

                        <span asp-validation-for="Note"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Buttons -->

                    <div class="mt-4">

                        <button type="submit"
                                class="btn btn-primary">

                            Save Restock

                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}