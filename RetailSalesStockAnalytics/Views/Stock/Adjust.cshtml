@model RetailSalesStockAnalytics.ViewModels.StockAdjustmentViewModel

@{
    ViewData["Title"] = "Stock Adjustment";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>
        <h1>Stock Adjustment</h1>

        <p class="text-muted mb-0">
            Correct stock quantity when physical inventory
            differs from the system.
        </p>
    </div>

    <a asp-controller="Stock"
       asp-action="Index"
       class="btn btn-secondary">

        ← Stock Dashboard

    </a>

</div>


<div class="row">

    <div class="col-md-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <h4 class="card-title mb-4">
                    Adjust Inventory
                </h4>


                <form asp-action="Adjust" method="post">

                    @Html.AntiForgeryToken()


                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3">
                    </div>


                    <!-- Product -->

                    <div class="mb-3">

                        <label asp-for="ProductId"
                               class="form-label">

                            Product

                        </label>

                        <select asp-for="ProductId"
                                asp-items="ViewBag.Products"
                                class="form-select">

                            <option value="">
                                -- Select Product --
                            </option>

                        </select>

                        <span asp-validation-for="ProductId"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Adjustment Quantity -->

                    <div class="mb-3">

                        <label asp-for="Quantity"
                               class="form-label">

                            Adjustment Quantity

                        </label>

                        <input asp-for="Quantity"
                               type="number"
                               class="form-control"
                               placeholder="Example: +5 or -3" />

                        <div class="form-text">

                            Use a positive number to add stock.
                            Use a negative number to remove stock.

                        </div>

                        <span asp-validation-for="Quantity"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- Reason -->

                    <div class="mb-3">

                        <label asp-for="Reason"
                               class="form-label">

                            Reason

                        </label>

                        <textarea asp-for="Reason"
                                  class="form-control"
                                  rows="3"
                                  placeholder="Example: Damaged products, stock count correction, etc.">
                        </textarea>

                        <span asp-validation-for="Reason"
                              class="text-danger">
                        </span>

                    </div>


                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary">

                            Save Adjustment

                        </button>

                        <a asp-controller="Stock"
                           asp-action="Index"
                           class="btn btn-secondary">

                            Cancel

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>


    <!-- Information -->

    <div class="col-md-6">

        <div class="card shadow-sm">

            <div class="card-body">

                <h5>
                    How Stock Adjustment Works
                </h5>

                <hr />

                <p>
                    Use a <strong>positive number</strong>
                    when you need to add stock.
                </p>

                <div class="alert alert-success">

                    Example:

                    <strong>+5</strong>

                    <br />

                    Stock 20 → Stock 25

                </div>


                <p>
                    Use a <strong>negative number</strong>
                    when you need to remove stock.
                </p>

                <div class="alert alert-warning">

                    Example:

                    <strong>-3</strong>

                    <br />

                    Stock 20 → Stock 17

                </div>


                <p class="mb-0">

                    Every adjustment is recorded in
                    <strong>Stock Transaction History</strong>.

                </p>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}