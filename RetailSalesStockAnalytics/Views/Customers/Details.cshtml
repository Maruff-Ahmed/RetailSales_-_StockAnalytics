@model RetailSalesStockAnalytics.Models.Customer

@{
    ViewData["Title"] = "Customer Details";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8 col-xl-6">

            <!-- Breadcrumb Navigation -->
            <div class="mb-3">
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
                        <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                    </svg>
                    Back to List
                </a>
            </div>

            <!-- Details Card -->
            <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
                <div class="card-header bg-white border-bottom py-3 d-flex justify-content-between align-items-center">
                    <div>
                        <h1 class="h4 fw-bold text-dark mb-1">Customer Details</h1>
                        <p class="text-muted small mb-0">Detailed profile and contact information.</p>
                    </div>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-2 rounded-pill">
                        Active Customer
                    </span>
                </div>

                <div class="card-body p-4">
                    <div class="list-group list-group-flush border rounded-3">

                        <!-- Name Field -->
                        <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center py-3 px-4">
                            <span class="text-secondary fw-semibold text-uppercase fs-7 mb-1 mb-sm-0">
                                @Html.DisplayNameFor(model => model.Name)
                            </span>
                            <span class="fw-bold text-dark fs-6">
                                @Html.DisplayFor(model => model.Name)
                            </span>
                        </div>

                        <!-- Phone Field -->
                        <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center py-3 px-4">
                            <span class="text-secondary fw-semibold text-uppercase fs-7 mb-1 mb-sm-0">
                                @Html.DisplayNameFor(model => model.Phone)
                            </span>
                            <span class="text-dark">
                                @Html.DisplayFor(model => model.Phone)
                            </span>
                        </div>

                        <!-- Email Field -->
                        <div class="list-group-item d-flex flex-column flex-sm-row justify-content-between align-items-sm-center py-3 px-4">
                            <span class="text-secondary fw-semibold text-uppercase fs-7 mb-1 mb-sm-0">
                                @Html.DisplayNameFor(model => model.Email)
                            </span>
                            <span class="text-dark">
                                @Html.DisplayFor(model => model.Email)
                            </span>
                        </div>

                    </div>
                </div>

                <!-- Footer Action Buttons -->
                <div class="card-footer bg-light border-top p-3 d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary px-4">
                        Back to List
                    </a>
                    <a asp-action="Edit" asp-route-id="@Model?.CustomerId" class="btn btn-primary d-inline-flex align-items-center gap-2 px-4 shadow-sm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325" />
                        </svg>
                        <span>Edit Customer</span>
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>