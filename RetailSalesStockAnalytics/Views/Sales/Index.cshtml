@model RetailSalesStockAnalytics.ViewModels.SalesIndexViewModel

@{
    ViewData["Title"] = "Sales";
}

<div class="container-fluid px-0 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-dark">Sales Records</h2>
            <p class="text-muted small mb-0">Overview of all customer transactions, revenue, and discounts.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary d-inline-flex align-items-center gap-2 shadow-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z" />
            </svg>
            <span>Record New Sale</span>
        </a>
    </div>

    <!-- Filter and Search Bar -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-3">
            <form method="get" asp-action="Index" class="row g-2 align-items-end">
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <input type="hidden" name="pageNumber" value="1" />

                <div class="col-12 col-md-4 col-lg-3">
                    <label class="form-label small text-muted mb-1">Search Customer or Token</label>
                    <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control form-control-sm" placeholder="Customer name or token..." />
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label small text-muted mb-1">From Date</label>
                    <input type="date" name="startDate" value="@(Model.StartDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <div class="col-6 col-md-3 col-lg-2">
                    <label class="form-label small text-muted mb-1">To Date</label>
                    <input type="date" name="endDate" value="@(Model.EndDate?.ToString("yyyy-MM-dd"))" class="form-control form-control-sm" />
                </div>

                <div class="col-8 col-md-4 col-lg-3">
                    <label class="form-label small text-muted mb-1">Sort By</label>
                    <select name="sortOrder" class="form-select form-select-sm">
                        <option value="date_desc" selected="@(Model.SortOrder == "date_desc" || string.IsNullOrEmpty(Model.SortOrder))">Newest First</option>
                        <option value="date_asc" selected="@(Model.SortOrder == "date_asc")">Oldest First</option>
                        <option value="amount_desc" selected="@(Model.SortOrder == "amount_desc")">Highest Amount</option>
                        <option value="amount_asc" selected="@(Model.SortOrder == "amount_asc")">Lowest Amount</option>
                        <option value="customer_asc" selected="@(Model.SortOrder == "customer_asc")">Customer (A-Z)</option>
                        <option value="customer_desc" selected="@(Model.SortOrder == "customer_desc")">Customer (Z-A)</option>
                    </select>
                </div>

                <div class="col-4 col-md-2 col-lg-2 d-flex gap-2">
                    <button type="submit" class="btn btn-sm btn-primary flex-grow-1 shadow-sm">Filter</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Standardized Table Card -->
    <div class="card border-0 shadow-sm rounded-3 overflow-hidden">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light text-secondary border-bottom">
                        <tr>
                            <th scope="col" class="ps-4 py-3 fw-semibold">
                                <a asp-action="Index"
                                   asp-route-sortOrder="@(Model.SortOrder == "customer_asc" ? "customer_desc" : "customer_asc")"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-pageNumber="1"
                                   class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
                                    <span>Customer</span>
                                </a>
                            </th>
                            <th scope="col" class="py-3 fw-semibold">
                                <a asp-action="Index"
                                   asp-route-sortOrder="@(Model.SortOrder == "date_asc" ? "date_desc" : "date_asc")"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-pageNumber="1"
                                   class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
                                    <span>Sale Date</span>
                                </a>
                            </th>
                            <th scope="col" class="py-3 fw-semibold text-end">
                                <a asp-action="Index"
                                   asp-route-sortOrder="@(Model.SortOrder == "amount_desc" ? "amount_asc" : "amount_desc")"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-pageNumber="1"
                                   class="text-decoration-none text-secondary d-inline-flex align-items-center gap-1">
                                    <span>Total Amount</span>
                                </a>
                            </th>
                            <th scope="col" class="py-3 fw-semibold text-end">
                                Discount
                            </th>
                            <th scope="col" class="pe-4 py-3 text-end fw-semibold">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Sales.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <div class="py-3">
                                        <p class="mb-2 fw-semibold">No sales transactions found</p>
                                        <small>Get started by recording your first sale or adjust your search filters.</small>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var item in Model.Sales)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-semibold text-dark">
                                        @(item.Customer?.Name ?? "-")
                                    </td>
                                    <td class="py-3 text-secondary">
                                        @item.SaleDate.ToString("dd MMM yyyy, hh:mm tt")
                                    </td>
                                    <td class="py-3 text-end font-monospace fw-bold text-dark">
                                        ৳@item.TotalAmount.ToString("N2")
                                    </td>
                                    <td class="py-3 text-end font-monospace text-secondary">
                                        ৳@item.Discount.ToString("N2")
                                    </td>
                                    <td class="pe-4 py-3 text-end">
                                        <div class="btn-group btn-group-sm" role="group" aria-label="Sale Actions">
                                            <a asp-action="Details" asp-route-id="@item.SaleId" class="btn btn-outline-secondary" title="Details">
                                                Details
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.SaleId" class="btn btn-outline-secondary" title="Edit">
                                                Edit
                                            </a>
                                            @if (User.IsInRole("Admin"))
                                            {
                                                <a asp-action="Delete" asp-route-id="@item.SaleId" class="btn btn-outline-danger" title="Cancel & Delete">
                                                    Delete
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls Footer -->
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-center gap-3 p-3 border-top bg-light-subtle">
                <!-- Record Count Info -->
                <div class="text-muted small">
                    @if (Model.TotalItems > 0)
                    {
                        <span>Showing <strong>@Model.FirstItemIndex</strong> to <strong>@Model.LastItemIndex</strong> of <strong>@Model.TotalItems</strong> transactions (Page <strong>@Model.PageNumber</strong> of <strong>@Model.TotalPages</strong>)</span>
                    }
                    else
                    {
                        <span>0 transactions found</span>
                    }
                </div>

                <!-- Page Size Selection -->
                <div class="d-flex align-items-center gap-2 small">
                    <span class="text-muted">Per page:</span>
                    <div class="btn-group btn-group-sm" role="group" aria-label="Page Size">
                        @foreach (var size in RetailSalesStockAnalytics.ViewModels.SalesIndexViewModel.AllowedPageSizes)
                        {
                            <a asp-action="Index"
                               asp-route-pageSize="@size"
                               asp-route-pageNumber="1"
                               asp-route-searchTerm="@Model.SearchTerm"
                               asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                               asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                               asp-route-sortOrder="@Model.SortOrder"
                               class="btn @(Model.PageSize == size ? "btn-primary" : "btn-outline-secondary")">
                                @size
                            </a>
                        }
                    </div>
                </div>

                <!-- Pagination Navigation -->
                @if (Model.TotalPages > 1)
                {
                    <nav aria-label="Sales page navigation">
                        <ul class="pagination pagination-sm mb-0">
                            <!-- Previous Page -->
                            <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber - 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   aria-label="Previous">
                                    <span aria-hidden="true">&laquo; Prev</span>
                                </a>
                            </li>

                            <!-- Page Numbers (Windowed) -->
                            @{
                                int startPage = Math.Max(1, Model.PageNumber - 2);
                                int endPage = Math.Min(Model.TotalPages, Model.PageNumber + 2);
                            }

                            @if (startPage > 1)
                            {
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="1"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-sortOrder="@Model.SortOrder">1</a>
                                </li>
                                @if (startPage > 2)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                            }

                            @for (int p = startPage; p <= endPage; p++)
                            {
                                <li class="page-item @(p == Model.PageNumber ? "active" : "")">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@p"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-sortOrder="@Model.SortOrder">@p</a>
                                </li>
                            }

                            @if (endPage < Model.TotalPages)
                            {
                                @if (endPage < Model.TotalPages - 1)
                                {
                                    <li class="page-item disabled"><span class="page-link">&hellip;</span></li>
                                }
                                <li class="page-item">
                                    <a class="page-link"
                                       asp-action="Index"
                                       asp-route-pageNumber="@Model.TotalPages"
                                       asp-route-pageSize="@Model.PageSize"
                                       asp-route-searchTerm="@Model.SearchTerm"
                                       asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                       asp-route-sortOrder="@Model.SortOrder">@Model.TotalPages</a>
                                </li>
                            }

                            <!-- Next Page -->
                            <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
                                <a class="page-link"
                                   asp-action="Index"
                                   asp-route-pageNumber="@(Model.PageNumber + 1)"
                                   asp-route-pageSize="@Model.PageSize"
                                   asp-route-searchTerm="@Model.SearchTerm"
                                   asp-route-startDate="@(Model.StartDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-endDate="@(Model.EndDate?.ToString("yyyy-MM-dd"))"
                                   asp-route-sortOrder="@Model.SortOrder"
                                   aria-label="Next">
                                    <span aria-hidden="true">Next &raquo;</span>
                                </a>
                            </li>
                        </ul>
                    </nav>
                }
            </div>
        </div>
    </div>
</div>
