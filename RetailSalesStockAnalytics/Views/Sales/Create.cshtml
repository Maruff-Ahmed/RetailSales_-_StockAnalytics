
@model RetailSalesStockAnalytics.ViewModels.SaleCreateViewModel

@{
    ViewData["Title"] = "New Sale";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1>New Sale</h1>

        <p class="text-muted mb-0">
            Enter customer information and create a sale.
        </p>

    </div>


    <a asp-action="Index"
       class="btn btn-outline-secondary">

        Sales History

    </a>

</div>

<hr />


<form asp-action="Create"
      method="post"
      id="saleCreateForm">

    <input type="hidden" asp-for="CheckoutToken" />

    <div asp-validation-summary="ModelOnly"
         class="text-danger mb-3">
    </div>


    <!-- =====================================================
         CUSTOMER INFORMATION
    ====================================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title mb-3">

                Customer Information

            </h5>


            <p class="text-muted small">

                Enter the customer details. Existing customers
                will be reused automatically when their phone
                number or email matches.

            </p>


            <div class="row">

                <!-- Customer Name -->

                <div class="col-md-4 mb-3">

                    <label asp-for="CustomerName"
                           class="form-label">

                        Customer Name *

                    </label>


                    <input asp-for="CustomerName"
                           class="form-control"
                           placeholder="Enter customer name" />


                    <span asp-validation-for="CustomerName"
                          class="text-danger">
                    </span>

                </div>


                <!-- Phone -->

                <div class="col-md-4 mb-3">

                    <label asp-for="CustomerPhone"
                           class="form-label">

                        Phone

                    </label>


                    <input asp-for="CustomerPhone"
                           class="form-control"
                           placeholder="Enter phone number" />


                    <span asp-validation-for="CustomerPhone"
                          class="text-danger">
                    </span>

                </div>


                <!-- Email -->

                <div class="col-md-4 mb-3">

                    <label asp-for="CustomerEmail"
                           class="form-label">

                        Email

                    </label>


                    <input asp-for="CustomerEmail"
                           class="form-control"
                           placeholder="Enter email address" />


                    <span asp-validation-for="CustomerEmail"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         SALE INFORMATION
    ====================================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <h5 class="card-title mb-3">

                Sale Information

            </h5>


            <div class="row">

                <!-- Sale Date -->

                <div class="col-md-6 mb-3">

                    <label asp-for="SaleDate"
                           class="form-label">

                        Sale Date

                    </label>


                    <input asp-for="SaleDate"
                           class="form-control"
                           type="datetime-local" />


                    <span asp-validation-for="SaleDate"
                          class="text-danger">
                    </span>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         SALE ITEMS
    ====================================================== -->

    <div class="card mb-4">

        <div class="card-body">

            <div class="d-flex justify-content-between
                        align-items-center mb-3">

                <h5 class="card-title mb-0">

                    Sale Items

                </h5>


                <button type="button"
                        id="addItem"
                        class="btn btn-secondary btn-sm">

                    + Add Product

                </button>

            </div>


            <div class="table-responsive">

                <table class="table table-bordered align-middle"
                       id="saleItemsTable">

                    <thead class="table-light">

                        <tr>

                            <th>
                                Product
                            </th>

                            <th style="width: 130px;">
                                Quantity
                            </th>

                            <th style="width: 140px;">
                                Unit Price
                            </th>

                            <th style="width: 150px;">
                                Item Total
                            </th>

                            <th style="width: 100px;">
                                Action
                            </th>

                        </tr>

                    </thead>


                    <tbody>

                        @for (int i = 0; i < Model.Items.Count; i++)
                        {
                            <tr class="sale-item-row">

                                <!-- Product -->

                                <td>

                                    <select name="Items[@i].ProductId"
                                            class="form-select product-select">

                                        <option value="">
                                            -- Select Product --
                                        </option>


                                        @foreach (var product in ViewBag.Products)
                                        {
                                            <option value="@product.ProductId"
                                                    data-price="@product.SellingPrice">

                                                @product.Name

                                            </option>
                                        }

                                    </select>

                                </td>


                                <!-- Quantity -->

                                <td>

                                    <input name="Items[@i].Quantity"
                                           type="number"
                                           min="1"
                                           value="@(Model.Items[i].Quantity > 0 ? Model.Items[i].Quantity : 1)"
                                           class="form-control quantity-input" />

                                </td>


                                <!-- Unit Price -->

                                <td>

                                    <span class="unit-price">
                                        ৳0.00
                                    </span>

                                </td>


                                <!-- Item Total -->

                                <td>

                                    <strong class="item-total">
                                        ৳0.00
                                    </strong>

                                </td>


                                <!-- Remove -->

                                <td>

                                    <button type="button"
                                            class="btn btn-danger btn-sm remove-item">

                                        Remove

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>



    <!-- =====================================================
         SALE SUMMARY
    ====================================================== -->

    <div class="row justify-content-end">

        <div class="col-md-5">

            <div class="card">

                <div class="card-body">

                    <h5 class="card-title mb-3">

                        Sale Summary

                    </h5>


                    <!-- Subtotal -->

                    <div class="d-flex justify-content-between mb-3">

                        <span>
                            Subtotal
                        </span>


                        <strong id="subtotalDisplay">
                            ৳0.00
                        </strong>

                    </div>


                    <!-- Discount -->

                    <div class="mb-3">

                        <label asp-for="Discount"
                               class="form-label">

                            Discount

                        </label>


                        <input asp-for="Discount"
                               class="form-control"
                               type="number"
                               step="0.01"
                               min="0"
                               id="discountInput" />


                        <span asp-validation-for="Discount"
                              class="text-danger">
                        </span>

                    </div>


                    <hr />


                    <!-- Net Revenue -->

                    <div class="d-flex justify-content-between">

                        <strong>
                            Net Revenue
                        </strong>


                        <strong id="netRevenueDisplay">
                            ৳0.00
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         BUTTONS
    ====================================================== -->

    <div class="mt-4">

        <button type="submit"
                id="submitSaleBtn"
                class="btn btn-primary">

            Save Sale

        </button>


        <a asp-action="Index"
           class="btn btn-secondary">

            Cancel

        </a>

    </div>

</form>



@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }


    <script>

        // =====================================================
        // Get price from selected product
        // =====================================================

        function getProductPrice(select) {

            const selectedOption =
                select.options[select.selectedIndex];

            if (!selectedOption) {
                return 0;
            }

            const price =
                parseFloat(
                    selectedOption.dataset.price
                );

            return isNaN(price) ? 0 : price;
        }



        // =====================================================
        // Calculate all totals
        // =====================================================

        function calculateTotals() {

            let subtotal = 0;


            const rows =
                document.querySelectorAll(
                    "#saleItemsTable tbody tr"
                );


            rows.forEach(function (row) {

                const productSelect =
                    row.querySelector(
                        ".product-select"
                    );


                const quantityInput =
                    row.querySelector(
                        ".quantity-input"
                    );


                const unitPriceElement =
                    row.querySelector(
                        ".unit-price"
                    );


                const itemTotalElement =
                    row.querySelector(
                        ".item-total"
                    );


                const unitPrice =
                    getProductPrice(
                        productSelect
                    );


                const quantity =
                    parseInt(
                        quantityInput.value
                    ) || 0;


                const itemTotal =
                    unitPrice * quantity;


                unitPriceElement.textContent =
                    "৳" +
                    unitPrice.toFixed(2);


                itemTotalElement.textContent =
                    "৳" +
                    itemTotal.toFixed(2);


                subtotal += itemTotal;

            });


            // -------------------------------------------------
            // Discount
            // -------------------------------------------------

            const discountInput =
                document.getElementById(
                    "discountInput"
                );


            let discount =
                parseFloat(
                    discountInput.value
                ) || 0;


            if (discount < 0) {
                discount = 0;
            }


            // -------------------------------------------------
            // Net Revenue
            // -------------------------------------------------

            let netRevenue =
                subtotal - discount;


            if (netRevenue < 0) {
                netRevenue = 0;
            }


            // -------------------------------------------------
            // Update UI
            // -------------------------------------------------

            document.getElementById(
                "subtotalDisplay"
            ).textContent =
                "৳" +
                subtotal.toFixed(2);


            document.getElementById(
                "netRevenueDisplay"
            ).textContent =
                "৳" +
                netRevenue.toFixed(2);

        }



        // =====================================================
        // Add Product
        // =====================================================

        document
            .getElementById("addItem")
            .addEventListener(
                "click",
                function () {

                    const tableBody =
                        document.querySelector(
                            "#saleItemsTable tbody"
                        );


                    const row =
                        document.createElement(
                            "tr"
                        );


                    row.className =
                        "sale-item-row";


                    row.innerHTML = `

                        <td>

                            <select class="form-select product-select">

                                <option value="">
                                    -- Select Product --
                                </option>

                                @foreach (var product in ViewBag.Products)
                                {
                                        <option value="@product.ProductId"
                                                data-price="@product.SellingPrice">

                                            @product.Name

                                        </option>
                                }

                            </select>

                        </td>


                        <td>

                            <input type="number"
                                   min="1"
                                   value="1"
                                   class="form-control quantity-input" />

                        </td>


                        <td>

                            <span class="unit-price">
                                ৳0.00
                            </span>

                        </td>


                        <td>

                            <strong class="item-total">
                                ৳0.00
                            </strong>

                        </td>


                        <td>

                            <button type="button"
                                    class="btn btn-danger btn-sm remove-item">

                                Remove

                            </button>

                        </td>

                    `;


                    tableBody.appendChild(row);


                    reindexRows();

                    calculateTotals();

                }
            );



        // =====================================================
        // Remove Product
        // =====================================================

        document.addEventListener(
            "click",
            function (event) {

                if (
                    event.target.classList
                        .contains("remove-item")
                ) {

                    const rows =
                        document.querySelectorAll(
                            "#saleItemsTable tbody tr"
                        );


                    if (rows.length <= 1) {

                        alert(
                            "At least one product is required."
                        );

                        return;
                    }


                    const row =
                        event.target.closest(
                            "tr"
                        );


                    row.remove();


                    reindexRows();

                    calculateTotals();

                }

            }
        );



        // =====================================================
        // Re-index rows
        // =====================================================

        function reindexRows() {

            const rows =
                document.querySelectorAll(
                    "#saleItemsTable tbody tr"
                );


            rows.forEach(
                function (row, index) {

                    const productSelect =
                        row.querySelector(
                            ".product-select"
                        );


                    const quantityInput =
                        row.querySelector(
                            ".quantity-input"
                        );


                    productSelect.name =
                        `Items[${index}].ProductId`;


                    quantityInput.name =
                        `Items[${index}].Quantity`;

                }
            );

        }



        // =====================================================
        // Product selection
        // =====================================================

        document.addEventListener(
            "change",
            function (event) {

                if (
                    event.target.classList
                        .contains("product-select")
                ) {

                    calculateTotals();

                }

            }
        );



        // =====================================================
        // Quantity / Discount changes
        // =====================================================

        document.addEventListener(
            "input",
            function (event) {

                if (
                    event.target.classList
                        .contains("quantity-input")
                    ||
                    event.target.id ===
                    "discountInput"
                ) {

                    calculateTotals();

                }

            }
        );



        // =====================================================
        // Initial setup
        // =====================================================

        reindexRows();

        calculateTotals();


        // =====================================================
        // Double-submit prevention
        // =====================================================

        const saleForm = document.getElementById("saleCreateForm");
        const submitSaleBtn = document.getElementById("submitSaleBtn");

        if (saleForm && submitSaleBtn) {
            let isSubmitting = false;

            saleForm.addEventListener("submit", function (e) {
                if (window.jQuery && $(saleForm).length && !$(saleForm).valid()) {
                    return;
                }

                if (saleForm.checkValidity && !saleForm.checkValidity()) {
                    return;
                }

                if (isSubmitting) {
                    e.preventDefault();
                    return false;
                }

                isSubmitting = true;
                submitSaleBtn.classList.add("disabled");
                submitSaleBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Saving Sale...';

                setTimeout(function () {
                    submitSaleBtn.disabled = true;
                }, 50);
            });
        }

    </script>

}

