@model RetailSalesStockAnalytics.Models.Sale

@{
    ViewData["Title"] = "Cancel Sale";
}

<div class="container-fluid px-0 py-3">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1 text-danger">Cancel &amp; Delete Sale</h2>
            <p class="text-muted small mb-0">Review transaction details and confirm sale cancellation.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline-secondary d-inline-flex align-items-center gap-1 shadow-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                    <path fill-rule="evenodd" d="M15 8a.5.5 0 0 0-.5-.5H2.707l3.147-3.146a.5.5 0 1 0-.708-.708l-4 4a.5.5 0 0 0 0 .708l4 4a.5.5 0 0 0 .708-.708L2.707 8.5H14.5A.5.5 0 0 0 15 8z" />
                </svg>
                <span>Back to List</span>
            </a>
        </div>
    </div>

    <!-- Stock Restoration Warning -->
    <div class="alert alert-warning d-flex align-items-center gap-3 mb-4" role="alert">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" viewBox="0 0 16 16" class="flex-shrink-0" aria-hidden="true">
            <path d="M8.982 1.566a1.13 1.13 0 0 0-1.96 0L.165 13.233c-.457.778.091 1.767.98 1.767h13.71c.889 0 1.438-.99.98-1.767L8.982 1.566zM8 5c.535 0 .954.462.9.995l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 5.995A.905.905 0 0 1 8 5zm.002 6a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
        </svg>
        <div>
            <h6 class="alert-heading fw-bold mb-1">Inventory Restoration Notice</h6>
            <p class="mb-0 small">
                Cancelling this sale will <strong>automatically restore stock quantities</strong> for all purchased items back to active inventory and generate permanent <em>"Sale Cancellation"</em> stock audit records.
            </p>
        </div>
    </div>

    <!-- Transaction Summary Card -->
    <div class="card border-0 shadow-sm rounded-3 mb-4">
        <div class="card-body p-4">
            <h6 class="fw-semibold text-secondary text-uppercase small tracking-wide mb-3">Transaction Information</h6>
            <div class="row g-3">
                <div class="col-md-3">
                    <span class="text-muted small d-block mb-1">Sale ID</span>
                    <span class="fw-bold font-monospace text-dark fs-6">#@Model.SaleId</span>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small d-block mb-1">Customer</span>
                    <span class="fw-semibold text-dark">@(Model.Customer?.Name ?? "Walk-in Customer")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small d-block mb-1">Transaction Date</span>
                    <span class="text-secondary">@Model.SaleDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                </div>
                <div class="col-md-3">
                    <span class="text-muted small d-block mb-1">Total Amount</span>
                    <span class="fw-bold font-monospace text-danger fs-6">৳@Model.TotalAmount.ToString("N2")</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Items to be Restored Table Card -->
    @if (Model.SaleItems != null && Model.SaleItems.Any())
    {
        <div class="card border-0 shadow-sm rounded-3 overflow-hidden mb-4">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="fw-semibold text-secondary text-uppercase small tracking-wide mb-0">Items to be Restored to Inventory</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light text-secondary border-bottom">
                            <tr>
                                <th scope="col" class="ps-4 py-3 fw-semibold">Product</th>
                                <th scope="col" class="py-3 fw-semibold text-center" style="width: 160px;">Quantity to Restore</th>
                                <th scope="col" class="py-3 fw-semibold text-end" style="width: 160px;">Unit Price</th>
                                <th scope="col" class="pe-4 py-3 text-end fw-semibold" style="width: 180px;">Line Total</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.SaleItems)
                            {
                                <tr>
                                    <td class="ps-4 py-3 fw-semibold text-dark">
                                        @(item.Product?.Name ?? $"Product #{item.ProductId}")
                                    </td>
                                    <td class="py-3 text-center">
                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 rounded-pill fw-medium">
                                            +@item.Quantity units
                                        </span>
                                    </td>
                                    <td class="py-3 text-end font-monospace text-secondary">
                                        ৳@item.UnitPrice.ToString("N2")
                                    </td>
                                    <td class="pe-4 py-3 text-end font-monospace text-dark">
                                        ৳@((item.Quantity * item.UnitPrice).ToString("N2"))
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }

    <!-- Confirmation Form -->
    <div class="card border-0 shadow-sm rounded-3">
        <div class="card-body p-4">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="SaleId" />
                <div class="d-flex align-items-center gap-2">
                    <button type="submit" class="btn btn-danger px-4 shadow-sm">
                        Confirm Sale Cancellation
                    </button>
                    <a asp-action="Index" class="btn btn-light text-secondary border px-3">
                        Keep Sale (Cancel)
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>
